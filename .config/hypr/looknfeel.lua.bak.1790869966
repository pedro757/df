hl.config({
  general = {
    gaps_in = 0,
    gaps_out = 0,
    border_size = 2,
    col = {
      inactive_border = "rgb(282828)",
    },
    layout = "scrolling",
  },
  scrolling = {
    column_width = 0.5,
  },
  cursor = {
    warp_on_change_workspace = 0,
  },
})

-- Keep border width fixed when focus changes; highlight only the active window.
-- Single-window workspaces still have no border.
o.window({ workspace = "w[1]" }, { border_size = 0 })

hl.animation({ leaf = "windowsMove", enabled = true, speed = 2, bezier = "easeOutQuint" })
