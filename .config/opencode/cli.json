{
  "theme": {
    "name": "system",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word",
    "tree": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show"
  },
  "tabs": {
    "enabled": false
  },
  "keybinds": {
    "app.exit": "ctrl+c,<leader>q",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "input.newline": "shift+return,ctrl+return,alt+return",
    "input.delete.to.line.end": "none",
    "input.move.up": "up,ctrl+k",
    "input.move.down": "down,ctrl+j",
    "input.move.left": "left,ctrl+h",
    "input.move.right": "right,ctrl+l",
    "input.delete": "delete,shift+delete",
    "input.select.up": "ctrl+k",
    "input.select.down": "ctrl+j",
    "session.list": "ctrl+s",
    "session.new": "<leader>n,ctrl+n",
    "variant.list": "<leader>v",
    "dialog.select.prev": "up,ctrl+p,ctrl+k",
    "dialog.select.next": "down,ctrl+n,ctrl+j",
    "dialog.select.submit": "return,ctrl+l",
    "prompt.autocomplete.prev": "up,ctrl+p,ctrl+k",
    "prompt.autocomplete.next": "down,ctrl+n,ctrl+j",
    "prompt.autocomplete.select": "return,ctrl+l",
    "session.sidebar.toggle": "ctrl+b"
  },
  "plugins": [
    "-opencode.notifications"
  ],
  "animations": true
}
