{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git branch *": "deny",
      "git push *": "deny",
      "pnpm -F nextjs typecheck": "allow",
      "pnpm format:fix *": "allow",
    }
  },
  // "agent": {
  //   "explore": {
  //     "model": "openrouter/openai/gpt-5.1-codex-mini",
  //   },
  //   "general": {
  //     "model": "openrouter/openai/gpt-5.1-codex-mini",
  //   }
  // },
  "provider": {
    "openrouter": {
      "models": {
        "openai/gpt-5.4": {
          "name": "GPT-5.4 Fast",
          "options": {
            "service_tier": "flex"
          }
        },
        "openai/gpt-5.5": {
          "name": "GPT-5.5 Fast",
          "options": {
            "service_tier": "flex"
          }
        }
      }
    },
  },
  "lsp": {
    "typescript": {
      "disabled": false,
      "command": [
        "tsgo",
        "--lsp",
        "--stdio"
      ]
    }
  },
  "experimental": {
    "continue_loop_on_deny": true,
  },
  // "plugin": ["@mohak34/opencode-notifier@latest"]
  // "mcp": {
  //   "react-grab-mcp": {
  //     "type": "local",
  //     "command": [
  //       "npx",
  //       "-y",
  //       "@react-grab/mcp",
  //       "--stdio"
  //     ]
  //   }
  // }
}
