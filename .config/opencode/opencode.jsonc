{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "title": {
      "model": "openai/gpt-6-luna"
    }
  },
  "autoupdate": true,
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" }
  ],
  "providers": {
    // Workaround for https://github.com/anomalyco/opencode/issues/61020: the saved Claude Agent catalog
    // is missing these windows, so they fall back to 200k and compaction starts at ~170k.
    // Claude Code 2.1.322 reports 1M for both. Remove once the upstream fix ships.
    "claude-agent": {
      "models": {
        "fable": { "limit": { "context": 1000000 } },
        "claude-fable-5-1": { "limit": { "context": 1000000 } }
      }
    },
    "openrouter": {
      "models": {
        "openai/gpt-5.4": {
          "name": "GPT-5.4 custom",
          "settings": {
            "service_tier": "flex"
          }
        },
        "openai/gpt-5.5": {
          "name": "GPT-5.5 custom",
          "settings": {
            "service_tier": "flex"
          }
        },
        "moonshotai/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
      }
    },
  },
  "lsp": {
    "custom-typescript": {
      "command": [
        "tsc",
        "--lsp",
        "--stdio"
      ],
      "extensions": [".ts", ".tsx"]
    }
  }
}
