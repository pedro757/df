{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "bash": {
      "*": "ask",
      "mkdir *": "allow",
      "ls *": "allow",
      "git *": "allow",
      "git branch *": "deny",
      "git push *": "deny",
      "pnpm typecheck *": "allow",
      "pnpm -F * typecheck *": "allow",
      "pnpm format:fix *": "allow",
      "pnpm lint *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "pnpm exec oxfmt *": "allow",
    }
  },
  "agent": {
    "explore": {
      "model": "openrouter/openai/gpt-5.5",
      "variant": "medium"
    },
    "general": {
      "model": "openrouter/openai/gpt-5.5",
      "variant": "medium"
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "openai/gpt-5.4": {
          "name": "GPT-5.4 custom",
          "options": {
            "service_tier": "flex"
          }
        },
        "openai/gpt-5.5": {
          "name": "GPT-5.5 custom",
          "options": {
            "service_tier": "flex"
          }
        },
        "moonshotai/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
      }
    },
  },
  "lsp": {
    "typescript": {
      "disabled": false,
      "command": [
        "tsgo",
        "--lsp",
        "--stdio"
      ]
    }
  },
  "experimental": {
    "continue_loop_on_deny": true,
  },
  "plugin": ["@mohak34/opencode-notifier@latest"]
  // "mcp": {
  //   "react-grab-mcp": {
  //     "type": "local",
  //     "command": [
  //       "npx",
  //       "-y",
  //       "@react-grab/mcp",
  //       "--stdio"
  //     ]
  //   }
  // }
}
