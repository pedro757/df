{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openrouter/openai/gpt-5-nano",
  "autoupdate": true,
  "permission": {
    "bash": "ask",
  },
  // "agent": {
  //   "explore": {
  //     "model": "openrouter/openai/gpt-5.1-codex-mini",
  //   },
  //   "general": {
  //     "model": "openrouter/openai/gpt-5.1-codex-mini",
  //   }
  // },
  "provider": {
    "openrouter": {
      "models": {
        "openai/gpt-5.3-codex": {
          "options": {
            "provider": {
              "order": ["openai"],
              "allow_fallbacks": false
            }
          }
        },
        "google/gemini-3.1-pro-preview-customtools": {
          "options": {
            "provider": {
              "order": ["google-ai-studio"],
              "allow_fallbacks": false
            }
          }
        },
        "moonshotai/kimi-k2.5": {
          "options": {
            "provider": {
              "order": ["moonshotai/int4"],
              "allow_fallbacks": false
            }
          }
        },
      },
    },
  },
  "lsp": {
    "typescript": {
      "disabled": false,
      "command": ["tsgo", "--lsp", "--stdio"]
    }
  },
  "experimental": {
    "continue_loop_on_deny": true,
  },
  // "mcp": {
  //   "react-grab-mcp": {
  //     "type": "local",
  //     "command": [
  //       "npx",
  //       "-y",
  //       "@react-grab/mcp",
  //       "--stdio"
  //     ]
  //   }
  // }
}
