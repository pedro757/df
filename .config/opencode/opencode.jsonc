    //         { "id": "low" },
    //         { "id": "medium" },
    //         { "id": "high" },
    //         { "id": "xhigh" },
    //         { "id": "max" }
    //       ]
    //     },
    //     "gpt-5.6-terra": {
    //       "name": "GPT-5.6 Terra custom",
    //       "settings": {
    //         "service_tier": "flex"
    //       },
    //       "variants": [
    //         { "id": "low" },
    //         { "id": "medium" },
    //         { "id": "high" },
    //         { "id": "xhigh" },
    //         { "id": "max" }
    //       ]
    //     },
    //     "gpt-5.6-luna": {
    //       "name": "GPT-5.6 Luna custom",
    //       "settings": {
    //         "service_tier": "flex"
    //       },
    //       "variants": [
    //         { "id": "low" },
    //         { "id": "medium" },
    //         { "id": "high" },
    //         { "id": "xhigh" },
    //         { "id": "max" }
    //       ]
    //     },
    //   }
    // },
  },
  "lsp": {
    "custom-typescript": {
      "command": [
        "tsc",
        "--lsp",
        "--stdio"
      ],
      "extensions": [".ts", ".tsx"],
      "env": {
        "TSS_LOG": "-level verbose"
      },
      "initialization": {
        "preferences": {
          "importModuleSpecifierPreference": "relative"
        }
      }
    }
  }
