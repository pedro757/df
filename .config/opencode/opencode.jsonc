    //         "medium": {},
    //         "high": {},
    //         "xhigh": {},
    //         "max": {}
    //       }
    //     },
    //   }
    // },
  },
  "lsp": {
    "typescript": {
      "disabled": false,
      "command": [
        "tsgo",
        "--lsp",
        "--stdio"
      ]
    }
  },
  "experimental": {
    "continue_loop_on_deny": true,
  },
  "plugin": ["@mohak34/opencode-notifier@latest"]
