{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "title": {
      "model": "openai/gpt-5.6-luna"
    }
  },
  "autoupdate": true,
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" }
  ],
  "providers": {
    "openrouter": {
      "models": {
        "openai/gpt-5.4": {
          "name": "GPT-5.4 custom",
          "settings": {
            "service_tier": "flex"
          }
        },
        "openai/gpt-5.5": {
          "name": "GPT-5.5 custom",
          "settings": {
            "service_tier": "flex"
          }
        },
        "moonshotai/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
      }
    },
    // "openai": {
    //   "models": {
    //     "gpt-5.6-sol": {
    //       "name": "GPT-5.6 Sol custom",
    //       "settings": {
    //         "service_tier": "flex"
