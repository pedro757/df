{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5-nano",
  "autoupdate": true,
  "permission": {
    "bash": {
      "*": "allow",
      "git push *": "deny",
      "rm -rf /": "deny"
    }
  },
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-terra",
      "variant": "xhigh"
    },
    "general": {
      "model": "openai/gpt-5.6-terra",
      "variant": "xhigh"
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "openai/gpt-5.4": {
          "name": "GPT-5.4 custom",
          "options": {
            "service_tier": "flex"
          }
        },
        "openai/gpt-5.5": {
          "name": "GPT-5.5 custom",
          "options": {
            "service_tier": "flex"
          }
        },
        "moonshotai/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
      }
    },
    // "openai": {
    //   "models": {
    //     "gpt-5.6-sol": {
    //       "name": "GPT-5.6 Sol custom",
    //       "options": {
    //         "service_tier": "flex"
    //       },
