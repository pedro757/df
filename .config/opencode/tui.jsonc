{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "system",
  "keybinds": {
    "app_exit": "ctrl+c,<leader>q",
    "messages_half_page_up": "ctrl+u",
    "messages_half_page_down": "ctrl+d",
    "input_newline": "shift+return,ctrl+return,alt+return",
    "input_delete_to_line_end": "none",
    "input_move_up": "up,ctrl+k",
    "input_move_down": "down,ctrl+j",
    "input_move_left": "left,ctrl+h",
    "input_move_right": "right,ctrl+l",
    "input_delete": "delete,shift+delete",
    "input_select_up": "ctrl+k",
    "input_select_down": "ctrl+j",
    "session_list": "ctrl+s",
    "session_new": "<leader>n,ctrl+n",
    "variant_list": "<leader>v",
    "dialog.select.prev": "up,ctrl+p,ctrl+k",
    "dialog.select.next": "down,ctrl+n,ctrl+j",
    "dialog.select.submit": "return,ctrl+l",
    "prompt.autocomplete.prev": "up,ctrl+p,ctrl+k",
    "prompt.autocomplete.next": "down,ctrl+n,ctrl+j",
    "prompt.autocomplete.select": "return,ctrl+l",
    "sidebar_toggle": "ctrl+b",
  }
}
