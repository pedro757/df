{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openrouter/openai/gpt-5-nano",
  // Theme configuration
  "theme": "opencode",
  "autoupdate": true,
  "permission": {
    "edit": "ask",
    "bash": "ask",
  },
  // "agent": {
  //   "explore": {
  //     "model": "openrouter/openai/gpt-5.1-codex-mini",
  //   },
  //   "general": {
  //     "model": "openrouter/openai/gpt-5.1-codex-mini",
  //   }
  // },
  "provider": {
    "openrouter": {
      "models": {
        "stepfun/step-3.5-flash:free": {
          "options": {
            "provider": {
              "order": ["stepfun/fp8"],
              "allow_fallbacks": false
            }
          }
        },
        "google/gemini-3-flash-preview": {
          "options": {
            "provider": {
              "order": ["google-ai-studio", "google-vertex"],
              "allow_fallbacks": false
            }
          }
        },
        "xiaomi/mimo-v2-flash": {
          "options": {
            "provider": {
              "order": ["xiaomi/fp8", "atlas-cloud/fp8"],
              "allow_fallbacks": false
            }
          }
        },
        "moonshotai/kimi-k2.5": {
          "options": {
            "provider": {
              "order": ["fireworks", "together", "moonshotai"],
              "allow_fallbacks": false
            }
          }
        },
      },
    },
  },
  "keybinds": {
    "messages_half_page_up": "ctrl+u",
    "messages_half_page_down": "ctrl+d",
  },
  "lsp": {
    "typescript": {
      "disabled": false,
      "command": ["tsgo", "--lsp", "--stdio"]
    }
  },
  "experimental": {
    "continue_loop_on_deny": true,
  },
}
